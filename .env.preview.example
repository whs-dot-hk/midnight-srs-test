# Copy to `.env.preview` and fill in a seed for a wallet you have funded on the
# Preview testnet. Loaded automatically when MN_ENV=preview (the default).
#
# Real environment variables win over this file, so `MN_SEED=… yarn srs …` and
# CI-injected secrets both work without editing it.
#
# `.env.*` is gitignored. Testnet seeds still control real testnet funds — treat
# the file as private and never reuse a seed anywhere that matters.

# A 64-character hex seed. The wallet must hold NIGHT and be DUST-registered;
# the first command run against a fresh seed bootstraps DUST automatically, but
# it cannot conjure NIGHT — use the Preview faucet first.
MN_SEED=replace-with-a-64-char-hex-seed

# Network to target. Also settable per-command: `MN_ENV=preprod yarn srs status …`.
#MN_ENV=preview

# Refuse to cold-sync a hosted wallet, failing instead if no cached snapshot
# exists. Off by default: the cache under .cache/wallet-state/ is written after
# each successful sync, so the first run cold-syncs and later runs delta-sync.
#MN_REQUIRE_WALLET_CACHE=1
